{
  "name": "@intentee/paddler-client",
  "version": "4.0.1",
  "description": "JavaScript/TypeScript client for the Paddler LLM load balancer",
  "license": "Apache-2.0",
  "homepage": "https://github.com/intentee/paddler",
  "repository": "https://github.com/intentee/paddler",
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "exports": {
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p tsconfig.test.json && node --experimental-eventsource --enable-source-maps --import tsx --test 'tests/unit/**/*.test.ts' 'tests/cluster/**/*.test.ts'",
    "test:coverage": "tsc -p tsconfig.test.json && node --experimental-eventsource --enable-source-maps --import tsx --test --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude='**/node_modules/**' --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-lines=100 'tests/**/*.test.ts'",
    "test:llm": "tsc -p tsconfig.test.json && node --experimental-eventsource --enable-source-maps --import tsx --test --test-concurrency=1 'tests/llm/**/*.test.ts'",
    "prepack": "tsc -p ."
  },
  "peerDependencies": {
    "rxjs": "^7.8",
    "zod": "^4"
  },
  "dependencies": {
    "nanoid": "5.1.16"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "tsx": "4.23.15",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
